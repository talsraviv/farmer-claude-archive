server {
    listen 127.0.0.1:8080;
    root /home/bubbles/farmer-claude;
    autoindex on;
    autoindex_exact_size off;
    autoindex_localtime on;
    location ~ /\. { deny all; }
    types {
        text/plain md log txt jsonl py sh;
        text/html html;
        image/jpeg jpg jpeg;
        image/png png;
    }
    default_type text/plain;
    charset utf-8;
}
